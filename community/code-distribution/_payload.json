relaticle\u002Fcustom-fields",[114,151,153],{"id":152},"distribution-guidelines","Distribution Guidelines",[155,156,158],"h4",{"id":157},"open-source-projects-agpl-30","Open Source Projects (AGPL-3.0)",[106,160,161],{},"When using Custom Fields under the AGPL-3.0 license:",[106,163,164],{},[109,165,166],{},"You CAN:",[119,168,169,172,175,178],{},[122,170,171],{},"Use Custom Fields in your open source projects",[122,173,174],{},"Modify and extend the codebase",[122,176,177],{},"Distribute your applications that use Custom Fields",[122,179,180],{},"Fork and create derivative works",[106,182,183],{},[109,184,185],{},"You MUST:",[119,187,188,191,194,197,200],{},[122,189,190],{},"Keep your project open source under AGPL-3.0",[122,192,193],{},"Provide access to your source code",[122,195,196],{},"Include the AGPL-3.0 license",[122,198,199],{},"Preserve copyright notices",[122,201,202],{},"Document any changes you make",[155,204,206],{"id":205},"commercial-projects","Commercial Projects",[106,208,209],{},"When using Custom Fields under a Commercial License:",[106,211,212],{},[109,213,166],{},[119,215,216,219,222,225,228],{},[122,217,218],{},"Use Custom Fields in closed-source applications",[122,220,221],{},"Modify the code without publishing changes",[122,223,224],{},"Distribute your application without source code",[122,226,227],{},"Keep your proprietary code private",[122,229,230],{},"Use in unlimited client projects (agencies)",[106,232,233],{},[109,234,235],{},"You CANNOT:",[119,237,238,241,244,247,250],{},[122,239,240],{},"Redistribute the Custom Fields source code itself",[122,242,243],{},"Resell Custom Fields as a standalone product",[122,245,246],{},"Remove copyright or license notices",[122,248,249],{},"Share your commercial license with others",[122,251,252],{},"Exceed your license tier's revenue\u002Fteam limits",[101,254,81],{"id":255},"contributing",[106,257,258],{},"We welcome contributions from the community!",[114,260,262],{"id":261},"how-to-contribute","How to Contribute",[264,265,266,272,278,284],"ol",{},[122,267,268,271],{},[109,269,270],{},"Fork the repository"," on GitHub",[122,273,274,277],{},[109,275,276],{},"Create a feature branch"," for your changes",[122,279,280,283],{},[109,281,282],{},"Submit a pull request"," with a clear description",[122,285,286,289],{},[109,287,288],{},"Sign the CLA"," (Contributor License Agreement) if required",[114,291,293],{"id":292},"contribution-guidelines","Contribution Guidelines",[119,295,296,299,302,305],{},[122,297,298],{},"Follow the existing code style and conventions",[122,300,301],{},"Write tests for new features",[122,303,304],{},"Update documentation as needed",[122,306,307],{},"Keep pull requests focused and atomic",[309,310,312],"alert",{"type":311},"info","By contributing to Custom Fields, you agree that your contributions will be licensed under the same dual license model (AGPL-3.0 + Commercial).",[101,314,316],{"id":315},"third-party-packages","Third-Party Packages",[106,318,319],{},"If you create packages or extensions for Custom Fields:",[119,321,322,328,334],{},[122,323,324,327],{},[109,325,326],{},"Open source packages",": Must be AGPL-3.0 compatible",[122,329,330,333],{},[109,331,332],{},"Commercial packages",": Require end-users to have appropriate Custom Fields license",[122,335,336,339],{},[109,337,338],{},"Always clearly state"," the licensing requirements",[101,341,343],{"id":342},"questions","Questions?",[106,345,346],{},"For questions about code distribution, licensing, or contributing:",[119,348,349,359,365],{},[122,350,351,354,355],{},[109,352,353],{},"Email",": ",[129,356,358],{"href":357},"mailto:customfieldsnext@gmail.com","customfieldsnext@gmail.com",[122,360,361,364],{},[109,362,363],{},"GitHub Issues",": For technical questions and bug reports",[122,366,367,370],{},[109,368,369],{},"Documentation",": Check our comprehensive docs first",{"title":372,"searchDepth":373,"depth":373,"links":374},"",2,[375,380,384,385],{"id":103,"depth":373,"text":1