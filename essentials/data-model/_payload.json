,1082],{},"DateTime",[147,1084,1085],{},[156,1086,797],{},[147,1088,1089],{},"date-time instance",[126,1091,1092,1095,1103],{},[147,1093,1094],{},"Single-choice",[147,1096,1097,1099,1100,1102],{},[156,1098,759],{},", or ",[156,1101,721],{}," when option keys are strings",[147,1104,1105],{},"option key",[126,1107,1108,1111,1115],{},[147,1109,1110],{},"Multi-choice",[147,1112,1113],{},[156,1114,810],{},[147,1116,1117],{},[156,1118,1119],{},"array",[106,1121,1122,1123,1125],{},"Email, phone and link are multi-choice types. They are stored as a JSON list in ",[156,1124,810],{},", even when the field allows one value.",[115,1127,1129],{"id":1128},"the-stored-form-of-each-type","The stored form of each type",[106,1131,1132,1133,839],{},"Normalization runs on strings only. For a list it runs on each item, drops an item that becomes empty, and collapses items that become equal. A single value that becomes empty is stored as ",[156,1134,838],{},[120,1136,1137,1149],{},[123,1138,1139],{},[126,1140,1141,1143,1146],{},[129,1142,245],{},[129,1144,1145],{},"Typed",[129,1147,1148],{},"Stored",[142,1150,1151,1166,1181,1199,1213,1228,1243],{},[126,1152,1153,1156,1161],{},[147,1154,1155],{},"Phone",[147,1157,1158],{},[156,1159,1160],{},"+1 (415) 555-0100",[147,1162,1163],{},[156,1164,1165],{},"+14155550100",[126,1167,1168,1171,1176],{},[147,1169,1170],{},"Phone with an extension",[147,1172,1173],{},[156,1174,1175],{},"+1 415 555 0100 ext. 12",[147,1177,1178],{},[156,1179,1180],{},"+14155550100;ext=12",[126,1182,1183,1189,1194],{},[147,1184,1185,1186],{},"Phone without a leading ",[156,1187,1188],{},"+",[147,1190,1191],{},[156,1192,1193],{},"415 555 0100",[147,1195,1196,1198],{},[156,1197,1193],{}," (trimmed, not parsed)",[126,1200,1201,1204,1208],{},[147,1202,1203],{},"Link",[147,1205,1206],{},[156,1207,927],{},[147,1209,1210],{},[156,1211,1212],{},"https:\u002F\u002Fexample.com\u002FPricing",[126,1214,1215,1218,1223],{},[147,1216,1217],{},"Link without a scheme",[147,1219,1220],{},[156,1221,1222],{},"Acme.com\u002FPath\u002F",[147,1224,1225],{},[156,1226,1227],{},"acme.com\u002FPath",[126,1229,1230,1233,1238],{},[147,1231,1232],{},"Email",[147,1234,1235],{},[156,1236,1237],{},"Jane@Example.com",[147,1239,1240,1242],{},[156,1241,1237],{}," (as typed)",[126,1244,1245,1248,1251],{},[147,1246,1247],{},"Every other type",[147,1249,1250],{},"as typed",[147,1252,1250],{},[106,1254,1255,1256,1259,1260,1263],{},"A link keeps its scheme because ",[156,1257,1258],{},"http:\u002F\u002F"," and ",[156,1261,1262],{},"https:\u002F\u002F"," can open different pages.",[106,1265,1266],{},"A date-time value is stored exactly as it is given. The package converts no timezone, so pass every value in one timezone, such as UTC.",[115,1268,1270],{"id":1269},"comparing-values","Comparing values",[106,1272,1273,1276,1277,1280],{},[156,1274,1275],{},"UniqueCustomFieldValue"," compares stored forms. It asks the field type for ",[156,1278,1279],{},"equivalentValues()",", the list of stored forms that count as the same value, and rejects a value when another record holds any of them.",[106,1282,1283,1284,1286,1287,1289,1290,1293,1294,839],{},"For a link, that list is the normalized value plus the value with ",[156,1285,1262],{},", with ",[156,1288,1258],{},", and with no scheme. A stored ",[156,1291,1292],{},"https:\u002F\u002Facme.com\u002Fpricing"," blocks a typed ",[156,1295,1296],{},"acme.com\u002Fpricing",[106,1298,1299],{},"Normalize a value the same way before you compare it in your own code:",[881,1301,1303],{"className":883,"code":1302,"language":885,"meta":886,"style":886},"use Relaticle\\CustomFields\\Facades\\CustomFieldsType;\n\n$stored = CustomFieldsType::getFieldTypeInstance($field->type)->normalize($typed, $field);\n",[156,1304,1305,1333,1337],{"__ignoreMap":886},[890,1306,1307,1311,1314,1317,1320,1322,1325,1327,1330],{"class":892,"line":893},[890,1308,1310],{"class":1309},"sbssI","use",[890,1312,1313],{"class":900}," Relaticle",[890,1315,1316],{"class":896},"\\",[890,1318,1319],{"class":900},"CustomFields",[890,1321,1316],{"class":896},[890,1323,1324],{"class":900},"Facades",[890,1326,1316],{"class":896},[890,1328,1329],{"class":900},"CustomFieldsType",[890,1331,1332],{"class":896},";\n",[890,1334,1335],{"class":892,"line":935},[890,1336,939],{"emptyLinePlaceholder":938},[890,1338,1339,1341,1344,1347,1351,1354,1357,1359,1362,1364,1366,1369,1372,1374,1377,1379,1382,1384],{"class":892,"line":942},[890,1340,897],{"class":896},[890,1342,1343],{"class":900},"stored ",[890,1345,1346],{"class":896},"=",[890,1348,1350],{"class":1349},"sBMFI"," CustomFieldsType",[890,1352,1353],{"class":896},"::",[890,1355,1356],{"class":907},"getFieldTypeInstance",[890,1358,911],{"class":896},[890,1360,1361],{"class":900},"field",[890,1363,904],{"class":896},[890,1365,305],{"class":900},[890,1367,1368],{"class":896},")->",[890,1370,1371],{"class":907},"normalize",[890,1373,911],{"class":896},[890,1375,1376],{"class":900},"typed",[890,1378,917],{"class":896},[890,1380,1381],{"class":896}," $",[890,1383,1361],{"class":900},[890,1385,958],{"class":896},[115,1387,1389],{"id":1388},"reading-and-querying","Reading and querying",[106,1391,1392,1395,1396,1399],{},[156,1393,1394],{},"getCustomFieldValue()"," returns the value of the typed column, decrypted when the field is encrypted. Call the ",[156,1397,1398],{},"withCustomFieldValues()"," scope first when you read many records, so the values load in one query.",[106,1401,1402,1403,1406],{},"To filter, query the typed column of the field. ",[156,1404,1405],{},"CustomField::getValueColumn()"," returns its name.",[881,1408,1410],{"className":883,"code":1409,"language":885,"meta":886,"style":886},"\u002F\u002F A scalar field\nCompany::whereHas('customFieldValues', fn ($query) => $query\n    ->where('custom_field_id', $revenueField->getKey())\n    ->where($revenueField->getValueColumn(), '>=', 1_000_000));\n\n\u002F\u002F A multi-choice field: compare against the stored form\nCompany::whereHas('customFieldValues', fn ($query) => $query\n    ->where('custom_field_id', $websiteField->getKey())\n    ->whereJsonContains('json_value', 'https:\u002F\u002Fexample.com\u002Fpricing'));\n",[156,1411,1412,1417,1459,1490,1524,1529,1535,1568,1595],{"__ignoreMap":886},[890,1413,1414],{"class":892,"line":893},[890,1415,1416],{"class":964},"\u002F\u002F A scalar field\n",[890,1418,1419,1422,1424,1427,1430,1432,1435,1437,1439,1443,1446,1449,1451,1454,1456],{"class":892,"line":935},[890,1420,1421],{"class":1349},"Company",[890,1423,1353],{"class":896},[890,1425,1426],{"class":907},"whereHas",[890,1428,1429],{"class":896},"(",[890,1431,923],{"class":896},[890,1433,1434],{"class":926},"customFieldValues",[890,1436,923],{"class":896},[890,1438,917],{"class":896},[890,1440,1442],{"class":1441},"spNyl"," fn",[890,1444,1445],{"class":896}," ($",[890,1447,1448],{"class":900},"query",[890,1450,533],{"class":896},[890,1452,1453],{"class":896}," =>",[890,1455,1381],{"class":896},[890,1457,1458],{"class":900},"query\n",[890,1460,1461,1464,1467,1469,1471,1473,1475,1477,1479,1482,1484,1487],{"class":892,"line":942},[890,1462,1463],{"class":896},"    ->",[890,1465,1466],{"class":907},"where",[890,1468,1429],{"class":896},[890,1470,923],{"class":896},[890,1472,608],{"class":926},[890,1474,923],{"class":896},[890,1476,917],{"class":896},[890,1478,1381],{"class":896},[890,1480,1481],{"class":900},"revenueField",[890,1483,904],{"class":896},[890,1485,1486],{"class":907},"getKey",[890,1488,1489],{"class":896},"())\n",[890,1491,1492,1494,1496,1498,1500,1502,1505,1508,1511,1514,1516,1518,1521],{"class":892,"line":961},[890,1493,1463],{"class":896},[890,1495,1466],{"class":907},[890,1497,911],{"class":896},[890,1499,1481],{"class":900},[890,1501,904],{"class":896},[890,1503,1504],{"class":907},"getValueColumn",[890,1506,1507],{"class":896},"(),",[890,1509,1510],{"class":896}," '",[890,1512,1513],{"class":926},">=",[890,1515,923],{"class":896},[890,1517,917],{"class":896},[890,1519,1520],{"class":1309}," 1_000_000",[890,1522,1523],{"class":896},"));\n",[890,1525,1527],{"class":892,"line":1526},5,[890,1528,939],{"emptyLinePlaceholder":938},[890,1530,1532],{"class":892,"line":1531},6,[890,1533,1534],{"class":964},"\u002F\u002F A multi-choice field: compare against the stored form\n",[890,1536,1538,1540,1542,1544,1546,1548,1550,1552,1554,1556,1558,1560,1562,1564,1566],{"class":892,"line":1537},7,[890,1539,1421],{"class":1349},[890,1541,1353],{"class":896},[890,1543,1426],{"class":907},[890,1545,1429],{"class":896},[890,1547,923],{"class":896},[890,1549,1434],{"class":926},[890,1551,923],{"class":896},[890,1553,917],{"class":896},[890,1555,1442],{"class":1441},[890,1557,1445],{"class":896},[890,1559,1448],{"class":900},[890,1561,533],{"class":896},[890,1563,1453],{"class":896},[890,1565,1381],{"class":896},[890,1567,1458],{"class":900},[890,1569,1571,1573,1575,1577,1579,1581,1583,1585,1587,1589,1591,1593],{"class":892,"line":1570},8,[890,1572,1463],{"class":896},[890,1574,1466],{"class":907},[890,1576,1429],{"class":896},[890,1578,923],{"class":896},[890,1580,608],{"class":926},[890,1582,923],{"class":896},[890,1584,917],{"class":896},[890,1586,1381],{"class":896},[890,1588,914],{"class":900},[890,1590,904],{"class":896},[890,1592,1486],{"class":907},[890,1594,1489],{"class":896},[890,1596,1598,1600,1603,1605,1607,1609,1611,1613,1615,1618,1620],{"class":892,"line":1597},9,[890,1599,1463],{"class":896},[890,1601,1602],{"class":907},"whereJsonContains",[890,1604,1429],{"class":896},[890,1606,923],{"class":896},[890,1608,810],{"class":926},[890,1610,923],{"class":896},[890,1612,917],{"class":896},[890,1614,1510],{"class":896},[890,1616,1617],{"class":926},"https:\u002F\u002Fexample.com\u002Fpricing",[890,1619,923],{"class":896},[890,1621,1523],{"class":896},[106,1623,1624],{},"An encrypted field cannot be filtered or sorted in SQL, because the column holds ciphertext.",[115,1626,1628],{"id":1627},"values-stored-by-an-older-version","Values stored by an older version",[106,1630,1631,1632,1638],{},"Normalization on every write path starts in 3.13. The package rewrites no existing row, so a value saved earlier keeps its old spelling until it is saved again. The ",[455,1633,1637],{"href":1634,"rel":1635},"https:\u002F\u002Fgithub.com\u002Frelaticle\u002Fcustom-fields\u002Fblob\u002F3.x\u002FUPGRADING.md",[1636],"nofollow","3.13 upgrade notes"," describe how to normalize old rows.",[101,1640,1642],{"id":1641},"design-philosophy","Design Philosophy",[115,1644,1646],{"id":1645},"type-safe-flexibility","Type-Safe Flexibility",[106,1648,1649,1650,1652],{},"The schema uses multiple typed columns in ",[156,1651,206],{}," rather than a single text column. This eliminates costly type conversions, enables native database sorting\u002Ffiltering, and maintains data integrity through database-level constraints. When you store an integer, it's actually stored as an integer—not a string that needs parsing.",[115,1654,1656],{"id":1655},"hierarchical-organization","Hierarchical Organization",[106,1658,1659],{},"Fields are organized into sections, providing logical grouping essential for complex forms. This two-level hierarchy supports progressive disclosure in UIs and administrative organization without adding complexity to simple use cases.",[115,1661,1663],{"id":1662},"performance-first-indexing","Performance-First Indexing",[106,1665,1666],{},"Strategic composite indexes optimize the most common query patterns: entity lookup, field discovery, and polymorphic joins. The schema is designed for the queries you'll actually run, not theoretical completeness.",[101,1668,1670],{"id":1669},"why-this-schema-design","Why This Schema Design",[106,1672,1673,1676,1677,526,1680,526,1683,1686,1687,1690],{},[110,1674,1675],{},"Polymorphic Flexibility",": Any model can have custom fields without tight coupling or migration dependencies. Add custom fields to ",[156,1678,1679],{},"Product",[156,1681,1682],{},"User",[156,1684,1685],{},"Order","—anything implementing the ",[156,1688,1689],{},"HasCustomFields"," interface.",[106,1692,1693,1696],{},[110,1694,1695],{},"Multi-Tenant Isolation",": Optional tenant awareness is built into the core schema, not bolted on later. When enabled, all data is automatically isolated between tenants while maintaining query performance.",[106,1698,1699,1702,1703,1705],{},[110,1700,1701],{},"Extensible Field Types",": Field types are pluggable through a clean interface. The ",[156,1704,375],{}," JSON column provides unlimited extension points without schema changes.",[106,1707,1708,1711],{},[110,1709,1710],{},"Efficient Querying",": Unlike traditional EAV models, this design supports efficient filtering and sorting on custom field values using native database types and proper indexing strategies.",[101,1713,1715],{"id":1714},"performance-considerations","Performance Considerations",[106,1717,1718],{},"This schema excels with complex forms, multi-tenant applications, and admin interfaces requiring dynamic field management. The typed storage and strategic indexing make it suitable for production applications with significant data volumes.",[106,1720,1721],{},"Consider the performance implications for sparse data (many NULL values) and plan custom queries for complex cross-field reporting needs. The architecture prioritizes the common case: efficient field definition, value storage\u002Fretrieval, and entity-centric queries.",[101,1723,1725],{"id":1724},"multi-tenancy-support","Multi-Tenancy Support",[106,1727,1728,1729,1731],{},"When enabled, ",[156,1730,388],{}," is included in all unique constraints and automatically filtered through model scopes. This ensures complete data isolation while maintaining query performance through proper indexing.",[1733,1734,1735],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-d