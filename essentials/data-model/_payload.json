,")",[116,521,522,526,528],{},[137,523,524],{},[146,525,340],{},[137,527,343],{},[137,529,346],{},[116,531,532,536,538],{},[137,533,534],{},[146,535,353],{},[137,537,343],{},[137,539,358],{},[116,541,542,546,548],{},[137,543,544],{},[146,545,365],{},[137,547,368],{},[137,549,550],{},"Type-specific configuration",[116,552,553,557,559],{},[137,554,555],{},[146,556,378],{},[137,558,249],{},[137,560,383],{},[221,562,564],{"label":563},"Options",[110,565,566,576],{},[113,567,568],{},[116,569,570,572,574],{},[119,571,232],{},[119,573,235],{},[119,575,130],{},[132,577,578,588,600,611,621,631],{},[116,579,580,584,586],{},[137,581,582],{},[146,583,246],{},[137,585,249],{},[137,587,252],{},[116,589,590,595,597],{},[137,591,592],{},[146,593,594],{},"custom_field_id",[137,596,249],{},[137,598,599],{},"Parent field",[116,601,602,606,608],{},[137,603,604],{},[146,605,283],{},[137,607,262],{},[137,609,610],{},"Option label",[116,612,613,617,619],{},[137,614,615],{},[146,616,327],{},[137,618,330],{},[137,620,333],{},[116,622,623,627,629],{},[137,624,625],{},[146,626,365],{},[137,628,368],{},[137,630,371],{},[116,632,633,637,639],{},[137,634,635],{},[146,636,378],{},[137,638,249],{},[137,640,383],{},[221,642,644],{"label":643},"Values",[110,645,646,656],{},[113,647,648],{},[116,649,650,652,654],{},[119,651,232],{},[119,653,235],{},[119,655,130],{},[132,657,658,668,678,690,701,713,726,738,750,763,776,789,801],{},[116,659,660,664,666],{},[137,661,662],{},[146,663,246],{},[137,665,249],{},[137,667,252],{},[116,669,670,674,676],{},[137,671,672],{},[146,673,259],{},[137,675,262],{},[137,677,265],{},[116,679,680,685,687],{},[137,681,682],{},[146,683,684],{},"entity_id",[137,686,249],{},[137,688,689],{},"Polymorphic entity ID",[116,691,692,696,698],{},[137,693,694],{},[146,695,594],{},[137,697,249],{},[137,699,700],{},"Field definition",[116,702,703,708,710],{},[137,704,705],{},[146,706,707],{},"string_value",[137,709,262],{},[137,711,712],{},"For text fields",[116,714,715,720,723],{},[137,716,717],{},[146,718,719],{},"text_value",[137,721,722],{},"text",[137,724,725],{},"For textarea fields",[116,727,728,733,735],{},[137,729,730],{},[146,731,732],{},"boolean_value",[137,734,343],{},[137,736,737],{},"For checkbox fields",[116,739,740,745,747],{},[137,741,742],{},[146,743,744],{},"integer_value",[137,746,249],{},[137,748,749],{},"For integer fields",[116,751,752,757,760],{},[137,753,754],{},[146,755,756],{},"float_value",[137,758,759],{},"double",[137,761,762],{},"For decimal fields",[116,764,765,770,773],{},[137,766,767],{},[146,768,769],{},"date_value",[137,771,772],{},"date",[137,774,775],{},"For date fields",[116,777,778,783,786],{},[137,779,780],{},[146,781,782],{},"datetime_value",[137,784,785],{},"datetime",[137,787,788],{},"For datetime fields",[116,790,791,796,798],{},[137,792,793],{},[146,794,795],{},"json_value",[137,797,368],{},[137,799,800],{},"For complex\u002Farray fields",[116,802,803,807,809],{},[137,804,805],{},[146,806,378],{},[137,808,249],{},[137,810,383],{},[91,812,814],{"id":813},"design-philosophy","Design Philosophy",[105,816,818],{"id":817},"type-safe-flexibility","Type-Safe Flexibility",[96,820,821,822,824],{},"The schema uses multiple typed columns in ",[146,823,196],{}," rather than a single text column. This eliminates costly type conversions, enables native database sorting\u002Ffiltering, and maintains data integrity through database-level constraints. When you store an integer, it's actually stored as an integer—not a string that needs parsing.",[105,826,828],{"id":827},"hierarchical-organization","Hierarchical Organization",[96,830,831],{},"Fields are organized into sections, providing logical grouping essential for complex forms. This two-level hierarchy supports progressive disclosure in UIs and administrative organization without adding complexity to simple use cases.",[105,833,835],{"id":834},"performance-first-indexing","Performance-First Indexing",[96,837,838],{},"Strategic composite indexes optimize the most common query patterns: entity lookup, field discovery, and polymorphic joins. The schema is designed for the queries you'll actually run, not theoretical completeness.",[91,840,842],{"id":841},"why-this-schema-design","Why This Schema Design",[96,844,845,848,849,512,852,512,855,858,859,862],{},[100,846,847],{},"Polymorphic Flexibility",": Any model can have custom fields without tight coupling or migration dependencies. Add custom fields to ",[146,850,851],{},"Product",[146,853,854],{},"User",[146,856,857],{},"Order","—anything implementing the ",[146,860,861],{},"HasCustomFields"," interface.",[96,864,865,868],{},[100,866,867],{},"Multi-Tenant Isolation",": Optional tenant awareness is built into the core schema, not bolted on later. When enabled, all data is automatically isolated between tenants while maintaining query performance.",[96,870,871,874,875,877],{},[100,872,873],{},"Extensible Field Types",": Field types are pluggable through a clean interface. The ",[146,876,365],{}," JSON column provides unlimited extension points without schema changes.",[96,879,880,883],{},[100,881,882],{},"Efficient Querying",": Unlike traditional EAV models, this design supports efficient filtering and sorting on custom field values using native database types and proper indexing strategies.",[91,885,887],{"id":886},"performance-considerations","Performance Considerations",[96,889,890],{},"This schema excels with complex forms, multi-tenant applications, and admin interfaces requiring dynamic field management. The typed storage and strategic indexing make it suitable for production applications with significant data volumes.",[96,892,893],{},"Consider the performance implications for sparse data (many NULL values) and plan custom queries for complex cross-field reporting needs. The architecture prioritizes the common case: efficient field definition, value storage\u002Fretrieval, and entity-centric queries.",[91,895,897],{"id":896},"multi-tenancy-support","Multi-Tenancy Support",[96,899,900,901,903],{},"When enabled, ",[146,902,378],{}," is included in all unique constraints and automatically filtered through model scopes. This ensures complete data isolation while maintaining query performance through proper indexing.",{"title":905,"searchDepth":906,"depth":906,"links":907},"",2,[908,913,918,919,920],{"id":93,"depth":906,"text":94,"children":909},[910,912],{"id":107,"depth":911,"text":108},3,{"id":215,"depth":911,"text":216},{"id":813,"depth":906,"text":814,"children":914},[915,916,917],{"id":817,"depth":911,"text":818},{"id":827,"depth":911,"text":828},{"id":834,"depth":911,"text":835},{"id":841,"depth":906,"text":842},{"id":886,"depth":906,"text":887},{"id":896,"depth":906,"text":897},"Understanding the Custom Fields database architecture","md",null,{},{"icon":59},{"title":56,"description":921},"5EkRCejxSToR-gbDhsJh69NSBAEr4Se7qV7LeBzZTZA",[929,931],{"title":51,"path":52,"stem":53,"description":930,"icon":54,"children":-1},"Learn how to import and export custom field data with import\u002Fexport actions",{"title":66,"path":67,"stem":68,"description":932,"icon":69,"children":-1},"Get help with Custom Fields",1785239732609]