ate exists.",[106,1654,1655,1656,1659],{},"Register once, from a service provider. Extensions persist until\n",[110,1657,1658],{},"FieldForm::flushSchemaExtensions()"," is called, which is primarily useful in tests.",[101,1661,1663],{"id":1662},"setting-accessors","setting() accessors",[106,1665,1666,950,1669,1672],{},[110,1667,1668],{},"CustomField::setting()",[110,1670,1671],{},"CustomFieldSection::setting()"," read a consumer-defined key\nout of the model's settings bag, with a default when the key is absent:",[122,1674,1676],{"className":124,"code":1675,"language":126,"meta":127,"style":127},"$field->setting('hidden_in_panels', []);\n$section->setting('hidden_in_panels', []);\n$field->setting('display.compact', false);\n",[110,1677,1678,1701,1723],{"__ignoreMap":127},[131,1679,1680,1682,1684,1686,1688,1690,1692,1694,1696,1698],{"class":133,"line":134},[131,1681,249],{"class":145},[131,1683,372],{"class":141},[131,1685,411],{"class":145},[131,1687,414],{"class":265},[131,1689,417],{"class":145},[131,1691,397],{"class":145},[131,1693,422],{"class":393},[131,1695,397],{"class":145},[131,1697,322],{"class":145},[131,1699,1700],{"class":145}," []);\n",[131,1702,1703,1705,1707,1709,1711,1713,1715,1717,1719,1721],{"class":133,"line":159},[131,1704,249],{"class":145},[131,1706,1538],{"class":141},[131,1708,411],{"class":145},[131,1710,414],{"class":265},[131,1712,417],{"class":145},[131,1714,397],{"class":145},[131,1716,422],{"class":393},[131,1718,397],{"class":145},[131,1720,322],{"class":145},[131,1722,1700],{"class":145},[131,1724,1725,1727,1729,1731,1733,1735,1737,1740,1742,1744],{"class":133,"line":183},[131,1726,249],{"class":145},[131,1728,372],{"class":141},[131,1730,411],{"class":145},[131,1732,414],{"class":265},[131,1734,417],{"class":145},[131,1736,397],{"class":145},[131,1738,1739],{"class":393},"display.compact",[131,1741,397],{"class":145},[131,1743,322],{"class":145},[131,1745,1746],{"class":145}," false);\n",[106,1748,1749,1751,1752,1755,1756,1758,1759,1762,1763,1765,1766,1768,1769,1772,1773,1776],{},[110,1750,1668],{}," reads from ",[110,1753,1754],{},"settings->additional","; ",[110,1757,1671],{},"\nreads from ",[110,1760,1761],{},"settings->extra",". These are the same bags that ",[110,1764,1387],{},"\nand ",[110,1767,1395],{}," write into via a ",[110,1770,1771],{},"settings.additional.*"," or\n",[110,1774,1775],{},"settings.extra.*"," statePath, so a filter callback and a schema extension are typically\nused together: the extension collects the setting, and the filter reads it back.",[106,1778,1779],{},"Both accessors support Laravel's dot notation and preserve explicitly stored nulls.",[106,1781,1782],{},"Saving an edit merges the submitted settings into the stored ones rather than replacing\nthem, so a key whose component the form did not render survives. The merge recurses into\nassociative arrays and replaces everything else, which means a submitted empty list or a\nsubmitted null still clears the value it targets, but a key nested inside an associative\nsetting can only be removed by code, not by leaving it out of a submission.",[106,1784,1785,1786,1789,1790,1793],{},"See ",[1787,1788,61],"a",{"href":62}," for ",[110,1791,1792],{},"onlySections()",", which narrows\nresolution a different way, by section identity rather than by an arbitrary predicate.",[1795,1796,1797],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .spNyl, html code.shiki .