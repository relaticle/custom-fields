includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 7
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    paths:
        - src
        - tests
    excludePaths:
        - tests
    ignoreErrors:
        # Ignore unused trait warnings for library traits meant to be consumed by package users
        - identifier: trait.unused
        # Laravel types raw SQL as literal-string; these compose grammar-wrapped columns and toSql() subqueries
        -
            message: '#expects (TValue of float\|int\|)?literal-string, (non-falsy-)?string given#'
            identifier: argument.type
            paths:
                - src/QueryBuilders/RecordLinkQuery.php
                - src/Support/ThroughRelationResolver.php
        # PHPStan bug: a nullable closure whose own parameter is nullable is not accepted as itself
        -
            message: '#^Method .+ should return \(Closure\(.+\|null.*\)\|null but returns#'
            identifier: return.type
            paths:
                - src/CustomFields.php
                - src/CustomFieldsPlugin.php
    parallel:
    		maximumNumberOfProcesses: 3