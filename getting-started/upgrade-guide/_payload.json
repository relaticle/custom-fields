45,146,174,186],"code",{"__ignoreMap":142},[147,148,151,155,159,162,166,169,171],"span",{"class":149,"line":150},"line",1,[147,152,154],{"class":153},"sBMFI","composer",[147,156,158],{"class":157},"sfazB"," require",[147,160,161],{"class":157}," relaticle\u002Fcustom-fields:",[147,163,165],{"class":164},"sMK4o","\"",[147,167,168],{"class":157},"^3.0",[147,170,165],{"class":164},[147,172,173],{"class":157}," -W\n",[147,175,177,180,183],{"class":149,"line":176},2,[147,178,179],{"class":153},"php",[147,181,182],{"class":157}," artisan",[147,184,185],{"class":157}," migrate\n",[147,187,189,191,193],{"class":149,"line":188},3,[147,190,179],{"class":153},[147,192,182],{"class":157},[147,194,195],{"class":157}," custom-fields:upgrade\n",[106,197,198],{},"The upgrade command automatically handles data migrations for phone fields, email fields, and lookup fields.",[200,201,203],"h3",{"id":202},"command-options","Command Options",[205,206,207,220],"table",{},[208,209,210],"thead",{},[211,212,213,217],"tr",{},[214,215,216],"th",{},"Option",[214,218,219],{},"Description",[221,222,223,234,244],"tbody",{},[211,224,225,231],{},[226,227,228],"td",{},[144,229,230],{},"--dry-run",[226,232,233],{},"Show what would be migrated without making changes",[211,235,236,241],{},[226,237,238],{},[144,239,240],{},"--force",[226,242,243],{},"Run without confirmation prompts",[211,245,246,251],{},[226,247,248],{},[144,249,250],{},"--skip=",[226,252,253],{},"Skip specific steps (comma-separated)",[106,255,256,259,260,263,264,263,267,263,270,263,273],{},[116,257,258],{},"Skippable steps",": ",[144,261,262],{},"lookup-fields",", ",[144,265,266],{},"email-format",[144,268,269],{},"phone-format",[144,271,272],{},"validate-schema",[144,274,275],{},"clear-caches",[137,277,279],{"className":139,"code":278,"language":141,"meta":142,"style":142},"# Preview changes without applying them\nphp artisan custom-fields:upgrade --dry-run\n\n# Run in CI\u002FCD without prompts\nphp artisan custom-fields:upgrade --force\n\n# Skip specific steps\nphp artisan custom-fields:upgrade --skip=clear-caches\nphp artisan custom-fields:upgrade --skip=email-format,phone-format\n",[144,280,281,287,299,305,311,323,328,334,346],{"__ignoreMap":142},[147,282,283],{"class":149,"line":150},[147,284,286],{"class":285},"sHwdD","# Preview changes without applying them\n",[147,288,289,291,293,296],{"class":149,"line":176},[147,290,179],{"class":153},[147,292,182],{"class":157},[147,294,295],{"class":157}," custom-fields:upgrade",[147,297,298],{"class":157}," --dry-run\n",[147,300,301],{"class":149,"line":188},[147,302,304],{"emptyLinePlaceholder":303},true,"\n",[147,306,308],{"class":149,"line":307},4,[147,309,310],{"class":285},"# Run in CI\u002FCD without prompts\n",[147,312,314,316,318,320],{"class":149,"line":313},5,[147,315,179],{"class":153},[147,317,182],{"class":157},[147,319,295],{"class":157},[147,321,322],{"class":157}," --force\n",[147,324,326],{"class":149,"line":325},6,[147,327,304],{"emptyLinePlaceholder":303},[147,329,331],{"class":149,"line":330},7,[147,332,333],{"class":285},"# Skip specific steps\n",[147,335,337,339,341,343],{"class":149,"line":336},8,[147,338,179],{"class":153},[147,340,182],{"class":157},[147,342,295],{"class":157},[147,344,345],{"class":157}," --skip=clear-caches\n",[147,347,349,351,353,355],{"class":149,"line":348},9,[147,350,179],{"class":153},[147,352,182],{"class":157},[147,354,295],{"class":157},[147,356,357],{"class":157}," --skip=email-format,phone-format\n",[101,359,361],{"id":360},"picking-up-new-migrations","Picking Up New Migrations",[106,363,364,365,368],{},"Package migrations are not run automatically by ",[144,366,367],{},"php artisan migrate"," after a version\nbump — they're only copied into your app on first install, or when you explicitly\nrepublish them:",[137,370,372],{"className":139,"code":371,"language":141,"meta":142,"style":142},"php artisan vendor:publish --tag=\"custom-fields-migrations\"\nphp artisan migrate\n",[144,373,374,394],{"__ignoreMap":142},[147,375,376,378,380,383,386,388,391],{"class":149,"line":150},[147,377,179],{"class":153},[147,379,182],{"class":157},[147,381,382],{"class":157}," vendor:publish",[147,384,385],{"class":157}," --tag=",[147,387,165],{"class":164},[147,389,390],{"class":157},"custom-fields-migrations",[147,392,393],{"class":164},"\"\n",[147,395,396,398,400],{"class":149,"line":176},[147,397,179],{"class":153},[147,399,182],{"class":157},[147,401,185],{"class":157},[106,403,404,405,408,409,412,413,416,417,420,421,424],{},"For example, a release may relax the ",[144,406,407],{},"custom_fields"," unique key from\n",[144,410,411],{},"(code, entity_type[, tenant])"," to ",[144,414,415],{},"(code, entity_type[, tenant], custom_field_section_id)","\nso a field code can be reused across different sections — the shape ",[144,418,419],{},"onlySections()"," (see\n",[422,423,61],"a",{"href":62},") relies on. Existing installs need the\nrepublish-and-migrate step above to pick that change up; it is not applied automatically.",[106,426,427,430],{},[116,428,429],{},"Before rolling that migration back",", resolve any rows that ended up sharing a code\nacross sections. The migration checks for this first and aborts with a clear error rather\nthan dropping the wide key and then failing to recreate the narrow one, which would leave\nthe table with no unique key at all.",[106,432,433,436,437,440,441,444,445,448],{},[116,434,435],{},"NULL is not unique-constrained."," ",[144,438,439],{},"custom_field_section_id"," is nullable, and both MySQL\nand Postgres treat ",[144,442,443],{},"NULL"," as distinct from every other value in a unique index — including\none that includes it. So after this migration, two sectionless fields\n(",[144,446,447],{},"custom_field_section_id IS NULL",") can still share a code for the same entity type, a\ncollision the narrow key used to prevent. There is no schema-level fix for this; keep\nsectionless codes unique at the application layer if you rely on that guarantee.",[101,450,452],{"id":451},"breaking-changes","Breaking Changes",[200,454,456],{"id":455},"high-impact","High Impact",[458,459,461],"h4",{"id":460},"filament-5-required","Filament 5 Required",[106,463,464,465,471],{},"Custom Fields v3 requires Filament 5. If you're still on Filament 4, upgrade Filament first following the ",[422,466,470],{"href":467,"rel":468},"https:\u002F\u002Ffilamentphp.com\u002Fdocs\u002F5.x\u002Fupgrade-guide",[469],"nofollow","Filament upgrade guide",".",[458,473,475],{"id":474},"lookup-fields-removed-from-non-record-types","Lookup Fields Removed from Non-Record Types",[106,477,478,479,482],{},"The ",[144,480,481],{},"lookup_type"," setting has been removed from field types that don't support entity lookups. The upgrade command migrates affected fields automatically.",[106,484,485,488],{},[116,486,487],{},"Affected field types",": Text, Textarea, Number, Date, DateTime, Email, Phone, and other non-relational types.",[106,490,491,492,494],{},"If you were using ",[144,493,481],{}," on these fields, they will be converted to standard fields.",[200,496,498],{"id":497},"medium-impact","Medium Impact",[458,500,502],{"id":501},"phone-field-format-changed","Phone Field Format Changed",[106,504,505],{},"Phone fields now store values as JSON arrays of E.164 strings (supporting multiple phone numbers):",[137,507,510],{"className":508,"code":509,"language":179,"meta":142,"style":142},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\u002F\u002F v2 format (single string in string_value column)\n\"+11234567890\"\n\n\u002F\u002F v3 format (JSON array in json_value column)\n[\"+11234567890\"]\n",[144,511,512,517,526,530,535],{"__ignoreMap":142},[147,513,514],{"class":149,"line":150},[147,515,516],{"class":285},"\u002F\u002F v2 format (single string in string_value column)\n",[147,518,519,521,524],{"class":149,"line":176},[147,520,165],{"class":164},[147,522,523],{"class":157},"+11234567890",[147,525,393],{"class":164},[147,527,528],{"class":149,"line":188},[147,529,304],{"emptyLinePlaceholder":303},[147,531,532],{"class":149,"line":307},[147,533,534],{"class":285},"\u002F\u002F v3 format (JSON array in json_value column)\n",[147,536,537,540,542,544,546],{"class":149,"line":313},[147,538,539],{"class":164},"[",[147,541,165],{"class":164},[147,543,523],{"class":157},[147,545,165],{"class":164},[147,547,548],{"class":164},"]\n",[106,550,551],{},"The upgrade command migrates existing phone values automatically.",[458,553,555],{"id":554},"email-field-format-changed","Email Field Format Changed",[106,557,558],{},"Email fields now support multiple values stored as JSON:",[137,560,562],{"className":508,"code":561,"language":179,"meta":142,"style":142},"\u002F\u002F v2 format (string)\n\"user@example.com\"\n\n\u002F\u002F v3 format (JSON array)\n[\"user@example.com\"]\n",[144,563,564,569,578,582,587],{"__ignoreMap":142},[147,565,566],{"class":149,"line":150},[147,567,568],{"class":285},"\u002F\u002F v2 format (string)\n",[147,570,571,573,576],{"class":149,"line":176},[147,572,165],{"class":164},[147,574,575],{"class":157},"user@example.com",[147,577,393],{"class":164},[147,579,580],{"class":149,"line":188},[147,581,304],{"emptyLinePlaceholder":303},[147,583,584],{"class":149,"line":307},[147,585,586],{"class":285},"\u002F\u002F v3 format (JSON array)\n",[147,588,589,591,593,595,597],{"class":149,"line":313},[147,590,539],{"class":164},[147,592,165],{"class":164},[147,594,575],{"class":157},[147,596,165],{"class":164},[147,598,548],{"class":164},[106,600,601],{},"The upgrade command migrates existing email values automatically.",[200,603,605],{"id":604},"low-impact","Low Impact",[458,607,609],{"id":608},"new-phone-validation-package","New Phone Validation Package",[106,611,612,613,616],{},"v3 adds ",[144,614,615],{},"propaganistas\u002Flaravel-phone"," for phone validation. This is installed automatically with composer.",[101,618,620],{"id":619},"manual-upgrade-steps","Manual Upgrade Steps",[106,622,623],{},"If you prefer manual control over the upgrade process:",[200,625,627],{"id":626},"_1-update-dependencies","1. Update Dependencies",[137,629,631],{"className":139,"code":630,"language":141,"meta":142,"style":142},"composer require relaticle\u002Fcustom-fields:\"^3.0\" -W\n",[144,632,633],{"__ignoreMap":142},[147,634,635,637,639,641,643,645,647],{"class":149,"line":150},[147,636,154],{"class":153},[147,638,158],{"class":157},[147,640,161],{"class":157},[147,642,165],{"class":164},[147,644,168],{"class":157},[147,646,165],{"class":164},[147,648,173],{"class":157},[200,650,652],{"id":651},"_2-run-migrations","2. Run Migrations",[137,654,656],{"className":139,"code":655,"language":141,"meta":142,"style":142},"php artisan migrate\n",[144,657,658],{"__ignoreMap":142},[147,659,660,662,664],{"class":149,"line":150},[147,661,179],{"class":153},[147,663,182],{"class":157},[147,665,185],{"class":157},[200,667,669],{"id":668},"_3-run-upgrade-command","3. Run Upgrade Command",[106,671,672],{},"The upgrade command performs these steps:",[674,675,676,682,688,694,700],"ol",{},[113,677,678,681],{},[116,679,680],{},"Migrate Lookup Fields"," - Removes lookup settings from non-record fields",[113,683,684,687],{},[116,685,686],{},"Migrate Email Format"," - Converts email strings to JSON arrays",[113,689,690,693],{},[116,691,692],{},"Migrate Phone Format"," - Converts phone strings to structured JSON",[113,695,696,699],{},[116,697,698],{},"Validate Schema"," - Checks database integrity",[113,701,702,705],{},[116,703,704],{},"Clear Caches"," - Clears all relevant caches",[137,707,709],{"className":139,"code":708,"language":141,"meta":142,"style":142},"php artisan custom-fields:upgrade\n",[144,710,711],{"__ignoreMap":142},[147,712,713,715,717],{"class":149,"line":150},[147,714,179],{"class":153},[147,716,182],{"class":157},[147,718,195],{"class":157},[106,720,721],{},"You can skip specific steps if needed:",[137,723,725],{"className":139,"code":724,"langu