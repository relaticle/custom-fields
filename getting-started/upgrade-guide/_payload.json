",[103,584,585,588],{},[106,586,587],{},"Migrate Email Format"," - Converts email strings to JSON arrays",[103,590,591,594],{},[106,592,593],{},"Migrate Phone Format"," - Converts phone strings to structured JSON",[103,596,597,600],{},[106,598,599],{},"Validate Schema"," - Checks database integrity",[103,602,603,606],{},[106,604,605],{},"Clear Caches"," - Clears all relevant caches",[127,608,610],{"className":129,"code":609,"language":131,"meta":132,"style":132},"php artisan custom-fields:upgrade\n",[134,611,612],{"__ignoreMap":132},[137,613,614,616,618],{"class":139,"line":140},[137,615,169],{"class":143},[137,617,172],{"class":147},[137,619,185],{"class":147},[96,621,622],{},"You can skip specific steps if needed:",[127,624,626],{"className":129,"code":625,"language":131,"meta":132,"style":132},"# Run everything except cache clearing\nphp artisan custom-fields:upgrade --skip=clear-caches\n\n# Run only lookup field migration\nphp artisan custom-fields:upgrade --skip=email-format,phone-format,validate-schema,clear-caches\n",[134,627,628,633,643,647,652],{"__ignoreMap":132},[137,629,630],{"class":139,"line":140},[137,631,632],{"class":275},"# Run everything except cache clearing\n",[137,634,635,637,639,641],{"class":139,"line":166},[137,636,169],{"class":143},[137,638,172],{"class":147},[137,640,285],{"class":147},[137,642,335],{"class":147},[137,644,645],{"class":139,"line":178},[137,646,294],{"emptyLinePlaceholder":293},[137,648,649],{"class":139,"line":297},[137,650,651],{"class":275},"# Run only lookup field migration\n",[137,653,654,656,658,660],{"class":139,"line":303},[137,655,169],{"class":143},[137,657,172],{"class":147},[137,659,285],{"class":147},[137,661,662],{"class":147}," --skip=email-format,phone-format,validate-schema,clear-caches\n",[190,664,666],{"id":665},"_4-clear-caches","4. Clear Caches",[127,668,670],{"className":129,"code":669,"language":131,"meta":132,"style":132},"php artisan cache:clear\nphp artisan config:clear\nphp artisan view:clear\nph