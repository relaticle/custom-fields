48},"sBMFI","composer",[142,151,153],{"class":152},"sfazB"," require",[142,155,156],{"class":152}," relaticle\u002Fcustom-fields:",[142,158,160],{"class":159},"sMK4o","\"",[142,162,163],{"class":152},"^3.0",[142,165,160],{"class":159},[142,167,168],{"class":152}," -W\n",[142,170,172,175,178],{"class":144,"line":171},2,[142,173,174],{"class":148},"php",[142,176,177],{"class":152}," artisan",[142,179,180],{"class":152}," migrate\n",[142,182,184,186,188],{"class":144,"line":183},3,[142,185,174],{"class":148},[142,187,177],{"class":152},[142,189,190],{"class":152}," custom-fields:upgrade\n",[101,192,193],{},"The upgrade command automatically handles data migrations for phone fields, email fields, and lookup fields.",[195,196,198],"h3",{"id":197},"command-options","Command Options",[200,201,202,215],"table",{},[203,204,205],"thead",{},[206,207,208,212],"tr",{},[209,210,211],"th",{},"Option",[209,213,214],{},"Description",[216,217,218,229,239],"tbody",{},[206,219,220,226],{},[221,222,223],"td",{},[139,224,225],{},"--dry-run",[221,227,228],{},"Show what would be migrated without making changes",[206,230,231,236],{},[221,232,233],{},[139,234,235],{},"--force",[221,237,238],{},"Run without confirmation prompts",[206,240,241,246],{},[221,242,243],{},[139,244,245],{},"--skip=",[221,247,248],{},"Skip specific steps (comma-separated)",[101,250,251,254,255,258,259,258,262,258,265,258,268],{},[111,252,253],{},"Skippable steps",": ",[139,256,257],{},"lookup-fields",", ",[139,260,261],{},"email-format",[139,263,264],{},"phone-format",[139,266,267],{},"validate-schema",[139,269,270],{},"clear-caches",[132,272,274],{"className":134,"code":273,"language":136,"meta":137,"style":137},"# Preview changes without applying them\nphp artisan custom-fields:upgrade --dry-run\n\n# Run in CI\u002FCD without prompts\nphp artisan custom-fields:upgrade --force\n\n# Skip specific steps\nphp artisan custom-fields:upgrade --skip=clear-caches\nphp artisan custom-fields:upgrade --skip=email-format,phone-format\n",[139,275,276,282,294,300,306,318,323,329,341],{"__ignoreMap":137},[142,277,278],{"class":144,"line":145},[142,279,281],{"class":280},"sHwdD","# Preview changes without applying them\n",[142,283,284,286,288,291],{"class":144,"line":171},[142,285,174],{"class":148},[142,287,177],{"class":152},[142,289,290],{"class":152}," custom-fields:upgrade",[142,292,293],{"class":152}," --dry-run\n",[142,295,296],{"class":144,"line":183},[142,297,299],{"emptyLinePlaceholder":298},true,"\n",[142,301,303],{"class":144,"line":302},4,[142,304,305],{"class":280},"# Run in CI\u002FCD without prompts\n",[142,307,309,311,313,315],{"class":144,"line":308},5,[142,310,174],{"class":148},[142,312,177],{"class":152},[142,314,290],{"class":152},[142,316,317],{"class":152}," --force\n",[142,319,321],{"class":144,"line":320},6,[142,322,299],{"emptyLinePlaceholder":298},[142,324,326],{"class":144,"line":325},7,[142,327,328],{"class":280},"# Skip specific steps\n",[142,330,332,334,336,338],{"class":144,"line":331},8,[142,333,174],{"class":148},[142,335,177],{"class":152},[142,337,290],{"class":152},[142,339,340],{"class":152}," --skip=clear-caches\n",[142,342,344,346,348,350],{"class":144,"line":343},9,[142,345,174],{"class":148},[142,347,177],{"class":152},[142,349,290],{"class":152},[142,351,352],{"class":152}," --skip=email-format,phone-format\n",[96,354,356],{"id":355},"picking-up-new-migrations","Picking Up New Migrations",[101,358,359,360,363],{},"Package migrations are not run automatically by ",[139,361,362],{},"php artisan migrate"," after a version\nbump — they're only copied into your app on first install, or when you explicitly\nrepublish them:",[132,365,367],{"className":134,"code":366,"language":136,"meta":137,"style":137},"php artisan vendor:publish --tag=\"custom-fields-migrations\"\nphp artisan migrate\n",[139,368,369,389],{"__ignoreMap":137},[142,370,371,373,375,378,381,383,386],{"class":144,"line":145},[142,372,174],{"class":148},[142,374,177],{"class":152},[142,376,377],{"class":152}," vendor:publish",[142,379,380],{"class":152}," --tag=",[142,382,160],{"class":159},[142,384,385],{"class":152},"custom-fields-migrations",[142,387,388],{"class":159},"\"\n",[142,390,391,393,395],{"class":144,"line":171},[142,392,174],{"class":148},[142,394,177],{"class":152},[142,396,180],{"class":152},[101,398,399,400,403,404,407,408,411,412,415,416,419],{},"For example, a release may relax the ",[139,401,402],{},"custom_fields"," unique key from\n",[139,405,406],{},"(code, entity_type[, tenant])"," to ",[139,409,410],{},"(code, entity_type[, tenant], custom_field_section_id)","\nso a field code can be reused across different sections — the shape ",[139,413,414],{},"onlySections()"," (see\n",[417,418,61],"a",{"href":62},") relies on. Existing installs need the\nrepublish-and-migrate step above to pick that change up; it is not applied automatically.",[101,421,422,425],{},[111,423,424],{},"Before rolling that migration back",", resolve any rows that ended up sharing a code\nacross sections. The migration checks for this first and aborts with a clear error rather\nthan dropping the wide key and then failing to recreate the narrow one, which would leave\nthe table with no unique key at all.",[101,427,428,431,432,435,436,439,440,443],{},[111,429,430],{},"NULL is not unique-constrained."," ",[139,433,434],{},"custom_field_section_id"," is nullable, and both MySQL\nand Postgres treat ",[139,437,438],{},"NULL"," as distinct from every other value in a unique index — including\none that includes it. So after this migration, two sectionless fields\n(",[139,441,442],{},"custom_field_section_id IS NULL",") can still share a code for the same entity type, a\ncollision the narrow key used to prevent. There is no schema-level fix for this; keep\nsectionless codes unique at the application layer if you rely on that guarantee.",[96,445,447],{"id":446},"breaking-changes","Breaking Changes",[195,449,451],{"id":450},"high-impact","High Impact",[453,454,456],"h4",{"id":455},"filament-5-required","Filament 5 Required",[101,458,459,460,466],{},"Custom Fields v3 requires Filament 5. If you're still on Filament 4, upgrade Filament first following the ",[417,461,465],{"href":462,"rel":463},"https:\u002F\u002Ffilamentphp.com\u002Fdocs\u002F5.x\u002Fupgrade-guide",[464],"nofollow","Filament upgrade guide",".",[453,468,470],{"id":469},"lookup-fields-removed-from-non-record-types","Lookup Fields Removed from Non-Record Types",[101,472,473,474,477],{},"The ",[139,475,476],{},"lookup_type"," setting has been removed from field types that don't support entity lookups. The upgrade command migrates affected fields automatically.",[101,479,480,483],{},[111,481,482],{},"Affected field types",": Text, Textarea, Number, Date, DateTime, Email, Phone, and other non-relational types.",[101,485,486,487,489],{},"If you were using ",[139,488,476],{}," on these fields, they will be converted to standard fields.",[195,491,493],{"id":492},"medium-impact","Medium Impact",[453,495,497],{"id":496},"phone-field-format-changed","Phone Field Format Changed",[101,499,500],{},"Phone fields now store values as JSON arrays of E.164 strings (supporting multiple phone numbers):",[132,502,505],{"className":503,"code":504,"language":174,"meta":137,"style":137},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\u002F\u002F v2 format (single string in string_value column)\n\"+11234567890\"\n\n\u002F\u002F v3 format (JSON array in json_value column)\n[\"+11234567890\"]\n",[139,506,507,512,521,525,530],{"__ignoreMap":137},[142,508,509],{"class":144,"line":145},[142,510,511],{"class":280},"\u002F\u002F v2 format (single string in string_value column)\n",[142,513,514,516,519],{"class":144,"line":171},[142,515,160],{"class":159},[142,517,518],{"class":152},"+11234567890",[142,520,388],{"class":159},[142,522,523],{"class":144,"line":183},[142,524,299],{"emptyLinePlaceholder":298},[142,526,527],{"class":144,"line":302},[142,528,529],{"class":280},"\u002F\u002F v3 format (JSON array in json_value column)\n",[142,531,532,535,537,539,541],{"class":144,"line":308},[142,533,534],{"class":159},"[",[142,536,160],{"class":159},[142,538,518],{"class":152},[142,540,160],{"class":159},[142,542,543],{"class":159},"]\n",[101,545,546],{},"The upgrade command migrates existing phone values automatically.",[453,548,550],{"id":549},"email-field-format-changed","Email Field Format Changed",[101,552,553],{},"Email fields now support multiple values stored as JSON:",[132,555,557],{"className":503,"code":556,"language":174,"meta":137,"style":137},"\u002F\u002F v2 format (string)\n\"user@example.com\"\n\n\u002F\u002F v3 format (JSON array)\n[\"user@example.com\"]\n",[139,558,559,564,573,577,582],{"__ignoreMap":137},[142,560,561],{"class":144,"line":145},[142,562,563],{"class":280},"\u002F\u002F v2 format (string)\n",[142,565,566,568,571],{"class":144,"line":171},[142,567,160],{"class":159},[142,569,570],{"class":152},"user@example.com",[142,572,388],{"class":159},[142,574,575],{"class":144,"line":183},[142,576,299],{"emptyLinePlaceholder":298},[142,578,579],{"class":144,"line":302},[142,580,581],{"class":280},"\u002F\u002F v3 format (JSON array)\n",[142,583,584,586,588,590,592],{"class":144,"line":308},[142,585,534],{"class":159},[142,587,160],{"class":159},[142,589,570],{"class":152},[142,591,160],{"class":159},[142,593,543],{"class":159},[101,595,596],{},"The upgrade command migrates existing email values automatically.",[195,598,600],{"id":599},"low-impact","Low Impact",[453,602,604],{"id":603},"new-phone-validation-package","New Phone Validation Package",[101,606,607,608,611],{},"v3 adds ",[139,609,610],{},"propaganistas\u002Flaravel-phone"," for phone validation. This is installed automatically with composer.",[96,613,615],{"id":614},"manual-upgrade-steps","Manual Upgrade Steps",[101,617,618],{},"If you prefer manual control over the upgrade process:",[195,620,622],{"id":621},"_1-update-dependencies","1. Update Dependencies",[132,624,626],{"className":134,"code":625,"language":136,"meta":137,"style":137},"composer require relaticle\u002Fcustom-fields:\"^3.0\" -W\n",[139,627,628],{"__ignoreMap":137},[142,629,630,632,634,636,638,640,642],{"class":144,"line":145},[142,631,149],{"class":148},[142,633,153],{"class":152},[142,635,156],{"class":152},[142,637,160],{"class":159},[142,639,163],{"class":152},[142,641,160],{"class":159},[142,643,168],{"class":152},[195,645,647],{"id":646},"_2-run-migrations","2. Run Migrations",[132,649,651],{"className":134,"code":650,"language":136,"meta":137,"style":137},"php artisan migrate\n",[139,652,653],{"__ignoreMap":137},[142,654,655,657,659],{"class":144,"line":145},[142,656,174],{"class":148},[142,658,177],{"class":152},[142,660,180],{"class":152},[195,662,664],{"id":663},"_3-run-upgrade-command","3. Run Upgrade Command",[101,666,667],{},"The upgrade command performs these steps:",[669,670,671,677,683,689,695],"ol",{},[108,672,673,676],{},[111,674,675],{},"Migrate Lookup Fields"," - Removes lookup settings from non-record fields",[108,678,679,682],{},[111,680,681],{},"Migrate Email Format"," - Converts email strings to JSON arrays",[108,684,685,688],{},[111,686,687],{},"Migrate Phone Format"," - Converts phone strings to structured JSON",[108,690,691,694],{},[111,692,693],{},"Validate Schema"," - Checks database integrity",[108,696,697,700],{},[111,698,699],{},"Clear Caches"," - Clears all relevant caches",[132,702,704],{"className":134,"code":703,"language":136,"meta":137,"style":137},"php artisan custom-fields:upgrade\n",[139,705,706],{"__ignoreMap":137},[142,707,708,710,712],{"class":144,"line":145},[142,709,174],{"class":148},[142,711,177],{"class":152},[142,713,190],{"class":152},[101,715,716],{},"You can skip specific steps if needed:",[132,718,720],{"className":134,"code":719,"language":136,"meta":137,"style":137},"# Run everything except cache clearing\nphp artisan custom-fields:upgrade --skip=clear-caches\n\n# Run only lookup 