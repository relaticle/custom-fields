],{},[131,144,145],{},"Filament"," 5.0+",[101,148,150],{"id":149},"quick-upgrade","Quick Upgrade",[152,153,158],"pre",{"className":154,"code":155,"language":156,"meta":157,"style":157},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","composer require relaticle\u002Fcustom-fields:\"^3.0\" -W\nphp artisan migrate\nphp artisan custom-fields:upgrade\n","bash","",[159,160,161,189,201],"code",{"__ignoreMap":157},[162,163,166,170,174,177,181,184,186],"span",{"class":164,"line":165},"line",1,[162,167,169],{"class":168},"sBMFI","composer",[162,171,173],{"class":172},"sfazB"," require",[162,175,176],{"class":172}," relaticle\u002Fcustom-fields:",[162,178,180],{"class":179},"sMK4o","\"",[162,182,183],{"class":172},"^3.0",[162,185,180],{"class":179},[162,187,188],{"class":172}," -W\n",[162,190,192,195,198],{"class":164,"line":191},2,[162,193,194],{"class":168},"php",[162,196,197],{"class":172}," artisan",[162,199,200],{"class":172}," migrate\n",[162,202,204,206,208],{"class":164,"line":203},3,[162,205,194],{"class":168},[162,207,197],{"class":172},[162,209,210],{"class":172}," custom-fields:upgrade\n",[106,212,213],{},"The upgrade command automatically handles data migrations for phone fields, email fields, and lookup fields.",[215,216,218],"h3",{"id":217},"command-options","Command Options",[220,221,222,235],"table",{},[223,224,225],"thead",{},[226,227,228,232],"tr",{},[229,230,231],"th",{},"Option",[229,233,234],{},"Description",[236,237,238,249,259],"tbody",{},[226,239,240,246],{},[241,242,243],"td",{},[159,244,245],{},"--dry-run",[241,247,248],{},"Show what would be migrated without making changes",[226,250,251,256],{},[241,252,253],{},[159,254,255],{},"--force",[241,257,258],{},"Run without confirmation prompts",[226,260,261,266],{},[241,262,263],{},[159,264,265],{},"--skip=",[241,267,268],{},"Skip specific steps (comma-separated)",[106,270,271,274,275,278,279,278,282,278,285,278,288],{},[131,272,273],{},"Skippable steps",": ",[159,276,277],{},"lookup-fields",", ",[159,280,281],{},"email-format",[159,283,284],{},"phone-format",[159,286,287],{},"validate-schema",[159,289,290],{},"clear-caches",[152,292,294],{"className":154,"code":293,"language":156,"meta":157,"style":157},"# Preview changes without applying them\nphp artisan custom-fields:upgrade --dry-run\n\n# Run in CI\u002FCD without prompts\nphp artisan custom-fields:upgrade --force\n\n# Skip specific steps\nphp artisan custom-fields:upgrade --skip=clear-caches\nphp artisan custom-fields:upgrade --skip=email-format,phone-format\n",[159,295,296,302,314,320,326,338,343,349,361],{"__ignoreMap":157},[162,297,298],{"class":164,"line":165},[162,299,301],{"class":300},"sHwdD","# Preview changes without applying them\n",[162,303,304,306,308,311],{"class":164,"line":191},[162,305,194],{"class":168},[162,307,197],{"class":172},[162,309,310],{"class":172}," custom-fields:upgrade",[162,312,313],{"class":172}," --dry-run\n",[162,315,316],{"class":164,"line":203},[162,317,319],{"emptyLinePlaceholder":318},true,"\n",[162,321,323],{"class":164,"line":322},4,[162,324,325],{"class":300},"# Run in CI\u002FCD without prompts\n",[162,327,329,331,333,335],{"class":164,"line":328},5,[162,330,194],{"class":168},[162,332,197],{"class":172},[162,334,310],{"class":172},[162,336,337],{"class":172}," --force\n",[162,339,341],{"class":164,"line":340},6,[162,342,319],{"emptyLinePlaceholder":318},[162,344,346],{"class":164,"line":345},7,[162,347,348],{"class":300},"# Skip specific steps\n",[162,350,352,354,356,358],{"class":164,"line":351},8,[162,353,194],{"class":168},[162,355,197],{"class":172},[162,357,310],{"class":172},[162,359,360],{"class":172}," --skip=clear-caches\n",[162,362,364,366,368,370],{"class":164,"line":363},9,[162,365,194],{"class":168},[162,367,197],{"class":172},[162,369,310],{"class":172},[162,371,372],{"class":172}," --skip=email-format,phone-format\n",[101,374,376],{"id":375},"picking-up-new-migrations","Picking Up New Migrations",[106,378,379,380,383],{},"Package migrations are not run automatically by ",[159,381,382],{},"php artisan migrate"," after a version\nbump — they're only copied into your app on first install, or when you explicitly\nrepublish them:",[152,385,387],{"className":154,"code":386,"language":156,"meta":157,"style":157},"php artisan vendor:publish --tag=\"custom-fields-migrations\"\nphp artisan migrate\n",[159,388,389,409],{"__ignoreMap":157},[162,390,391,393,395,398,401,403,406],{"class":164,"line":165},[162,392,194],{"class":168},[162,394,197],{"class":172},[162,396,397],{"class":172}," vendor:publish",[162,399,400],{"class":172}," --tag=",[162,402,180],{"class":179},[162,404,405],{"class":172},"custom-fields-migrations",[162,407,408],{"class":179},"\"\n",[162,410,411,413,415],{"class":164,"line":191},[162,412,194],{"class":168},[162,414,197],{"class":172},[162,416,200],{"class":172},[106,418,419,420,423,424,427,428,431,432,435,436,438],{},"For example, a release may relax the ",[159,421,422],{},"custom_fields"," unique key from\n",[159,425,426],{},"(code, entity_type[, tenant])"," to ",[159,429,430],{},"(code, entity_type[, tenant], custom_field_section_id)","\nso a field code can be reused across different sections — the shape ",[159,433,434],{},"onlySections()"," (see\n",[110,437,61],{"href":62},") relies on. Existing installs need the\nrepublish-and-migrate step above to pick that change up; it is not applied automatically.",[106,440,441,444],{},[131,442,443],{},"Before rolling that migration back",", resolve any rows that ended up sharing a code\nacross sections. The migration checks for this first and aborts with a clear error rather\nthan dropping the wide key and then failing to recreate the narrow one, which would leave\nthe table with no unique key at all.",[106,446,447,450,451,454,455,458,459,462],{},[131,448,449],{},"NULL is not unique-constrained."," ",[159,452,453],{},"custom_field_section_id"," is nullable, and both MySQL\nand Postgres treat ",[159,456,457],{},"NULL"," as distinct from every other value in a unique index — including\none that includes it. So after this migration, two sectionless fields\n(",[159,460,461],{},"custom_field_section_id IS NULL",") can still share a code for the same entity type, a\ncollision the narrow key used to prevent. There is no schema-level fix for this; keep\nsectionless codes unique at the application layer if you rely on that guarantee.",[101,464,466],{"id":465},"breaking-changes","Breaking Changes",[215,468,470],{"id":469},"high-impact","High Impact",[472,473,475],"h4",{"id":474},"filament-5-required","Filament 5 Required",[106,477,478,479,116],{},"Custom Fields v3 requires Filament 5. If you're still on Filament 4, upgrade Filament first following the ",[110,480,483],{"href":481,"rel":482},"https:\u002F\u002Ffilamentphp.com\u002Fdocs\u002F5.x\u002Fupgrade-guide",[114],"Filament upgrade guide",[472,485,487],{"id":486},"lookup-fields-removed-from-non-record-types","Lookup Fields Removed from Non-Record Types",[106,489,490,491,494],{},"The ",[159,492,493],{},"lookup_type"," setting has been removed from field types that don't support entity lookups. The upgrade command migrates affected fields automatically.",[106,496,497,500],{},[131,498,499],{},"Affected field types",": Text, Textarea, Number, Date, DateTime, Email, Phone, and other non-relational types.",[106,502,503,504,506],{},"If you were using ",[159,505,493],{}," on these fields, they will be converted to standard fields.",[215,508,510],{"id":509},"medium-impact","Medium Impact",[472,512,514],{"id":513},"phone-field-format-changed","Phone Field Format Changed",[106,516,517],{},"Phone fields now store values as JSON arrays of E.164 strings (supporting multiple phone numbers):",[152,519,522],{"className":520,"code":521,"language":194,"meta":157,"style":157},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\u002F\u002F v2 format (single string in string_value column)\n\"+11234567890\"\n\n\u002F\u002F v3 format (JSON array in json_value column)\n[\"+11234567890\"]\n",[159,523,524,529,538,542,547],{"__ignoreMap":157},[162,525,526],{"class":164,"line":165},[162,527,528],{"class":300},"\u002F\u002F v2 format (single string in string_value column)\n",[162,530,531,533,536],{"class":164,"line":191},[162,532,180],{"class":179},[162,534,535],{"class":172},"+11234567890",[162,537,408],{"class":179},[162,539,540],{"class":164,"line":203},[162,541,319],{"emptyLinePlaceholder":318},[162,543,544],{"class":164,"line":322},[162,545,546],{"class":300},"\u002F\u002F v3 format (JSON array in json_value column)\n",[162,548,549,552,554,556,558],{"class":164,"line":328},[162,550,551],{"class":179},"[",[162,553,180],{"class":179},[162,555,535],{"class":172},[162,557,180],{"class":179},[162,559,560],{"class":179},"]\n",[106,562,563],{},"The upgrade command migrates existing phone values automatically.",[472,565,567],{"id":566},"email-field-format-changed","Email Field Format Changed",[106,569,570],{},"Email fields now support multiple values stored as JSON:",[152,572,574],{"className":520,"code":573,"language":194,"meta":157,"style":157},"\u002F\u002F v2 format (string)\n\"user@example.com\"\n\n\u002F\u002F v3 format (JSON array)\n[\"user@example.com\"]\n",[159,575,576,581,590,594,599],{"__ignoreMap":157},[162,577,578],{"class":164,"line":165},[162,579,580],{"class":300},"\u002F\u002F v2 format (string)\n",[162,582,583,585,588],{"class":164,"line":191},[162,584,180],{"class":179},[162,586,587],{"class":172},"user@example.com",[162,589,408],{"class":179},[162,591,592],{"class":164,"line":203},[162,593,319],{"emptyLinePlaceholder":318},[162,595,596],{"class":164,"line":322},[162,597,598],{"class":300},"\u002F\u002F v3 format (JSON array)\n",[162,600,601,603,605,607,609],{"class":164,"line":328},[162,602,551],{"class":179},[162,604,180],{"class":179},[162,606,587],{"class":172},[162,608,180],{"class":179},[162,610,560],{"class":179},[106,612,613],{},"The upgrade command migrates existing email values automatically.",[215,615,617],{"id":616},"low-impact","Low Impact",[472,619,621],{"id":620},"new-phone-validation-package","New Phone Validation Package",[106,623,624,625,628],{},"v3 adds ",[159,626,627],{},"propaganistas\u002Flaravel-phone"," for phone validation. This is installed automatically with composer.",[101,630,632],{"id":631},"manual-upgrade-steps","Manual Upgrade Steps",[106,634,635],{},"If you prefer manual control over the upgrade process:",[215,637,639],{"id":638},"_1-update-dependencies","1. Update Dependencies",[152,641,643],{"className":154,"code":642,"language":156,"meta":157,"style":157},"composer require relaticle\u002Fcustom-fields:\"^3.0\" -W\n",[159,644,645],{"__ignoreMap":157},[162,646,647,649,651,653,655,657,659],{"class":164,"line":165},[162,648,169],{"class":168},[162,650,173],{"class":172},[162,652,176],{"class":172},[162,654,180],{"class":179},[162,656,183],{"class":172},[162,658,180],{"class":179},[162,660,188],{"class":172},[215,662,664],{"id":663},"_2-run-migrations","2. Run Migrations",[152,666,668],{"className":154,"code":667,"language":156,"meta":157,"style":157},"php artisan migrate\n",[159,669,670],{"__ignoreMap":157},[162,671,672,674,676],{"class":164,"line":165},[162,673,194],{"class":168},[162,675,197],{"class":172},[162,677,200],{"class":172},[215,679,681],{"id":680},"_3-run-upgrade-command","3. Run Upgrade Command",[106,683,684],{},"The upgrade command performs these steps:",[686,687,688,694,700,706,712],"ol",{},[128,689,690,693],{},[131,691,692],{},"Migrate Lookup Fields"," - Removes lookup settings from non-record fields",[128,695,696,699],{},[131,697,698],{},"Migrate Email Format"," - Converts email strings to JSON arrays",[128,701,702,705],{},[131,703,704],{},"Migrate Phone Format"," - Converts phone strings to structured JSON",[128,707,708,711],{},[131,709,710],{},"Validate Schema"," - Checks database integrity",[128,713,714,717],{},[131,715,716],{},"Clear Caches"," - Clears all relevant 